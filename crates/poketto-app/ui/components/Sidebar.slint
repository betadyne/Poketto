import { Theme } from "../tokens.slint";

export component Sidebar inherits Rectangle {
    in property <int> active-screen;
    callback nav-library;
    callback nav-settings;
    callback nav-logs;

    property <bool> library-active: root.active-screen == 0 || root.active-screen == 1;
    property <bool> settings-active: root.active-screen == 2;
    property <bool> logs-active: root.active-screen == 3;

    width: 220px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.pad-md;
        spacing: 0;

        Text {
            text: "Poketto";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        Rectangle { height: 24px; }

        Rectangle {
            height: 48px;
            background: touch-lib.has-hover ? Theme.surface : transparent;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.library-active ? Theme.primary : (touch-lib.has-hover ? Theme.surface-hover : Theme.surface);
                    border-radius: 6px;

                    Image {
                        source: @image-url("../icons/books.svg");
                        width: 18px;
                        height: 18px;
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        colorize: root.library-active ? Theme.text-on-primary : Theme.text-muted;
                    }
                }

                Text {
                    text: "My Games";
                    color: root.library-active ? Theme.text : Theme.text-muted;
                    font-size: 14px;
                    font-weight: root.library-active ? 600 : 500;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-lib := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-library(); }
            }
        }

        Rectangle { height: 10px; }

        Rectangle {
            height: 1px;
            background: Theme.surface;
        }

        Rectangle { height: 10px; }

        Rectangle {
            height: 48px;
            background: touch-set.has-hover ? Theme.surface : transparent;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.settings-active ? Theme.primary : (touch-set.has-hover ? Theme.surface-hover : Theme.surface);
                    border-radius: 6px;

                    Image {
                        source: @image-url("../icons/settings.svg");
                        width: 18px;
                        height: 18px;
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        colorize: root.settings-active ? Theme.text-on-primary : Theme.text-muted;
                    }
                }

                Text {
                    text: "Settings";
                    color: root.settings-active ? Theme.text : Theme.text-muted;
                    font-size: 14px;
                    font-weight: root.settings-active ? 600 : 500;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-set := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-settings(); }
            }
        }

        Rectangle { height: 10px; }

        Rectangle {
            height: 48px;
            background: touch-logs.has-hover ? Theme.surface : transparent;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.logs-active ? Theme.primary : (touch-logs.has-hover ? Theme.surface-hover : Theme.surface);
                    border-radius: 6px;

                    Image {
                        source: @image-url("../icons/file-text.svg");
                        width: 18px;
                        height: 18px;
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        colorize: root.logs-active ? Theme.text-on-primary : Theme.text-muted;
                    }
                }

                Text {
                    text: "Logs";
                    color: root.logs-active ? Theme.text : Theme.text-muted;
                    font-size: 14px;
                    font-weight: root.logs-active ? 600 : 500;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-logs := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-logs(); }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: "Poketto Version: 0.1.0-beta";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }
    }
}
