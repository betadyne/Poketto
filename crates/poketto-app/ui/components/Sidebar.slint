import { Theme } from "../tokens.slint";

export component Sidebar inherits Rectangle {
    in property <int> active-screen;
    callback nav-library;
    callback nav-settings;
    callback nav-logs;

    property <bool> library-active: root.active-screen == 0 || root.active-screen == 1;
    property <bool> settings-active: root.active-screen == 2;
    property <bool> logs-active: root.active-screen == 3;

    width: 220px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: Theme.pad-md;
        spacing: 4px;

        Text {
            text: "Poketto";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        Rectangle { height: Theme.space-md; }

        Rectangle {
            height: 40px;
            background: touch-lib.has-hover || root.library-active ? (root.library-active ? Theme.primary : Theme.surface) : transparent;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: Theme.pad-sm;
                padding-right: Theme.pad-sm;
                spacing: Theme.space-sm;

                Image {
                    source: @image-url("../icons/books.svg");
                    width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    colorize: root.library-active ? Theme.text-on-primary : Theme.text-muted;
                }

                Text {
                    text: "My Games";
                    color: root.library-active ? Theme.text-on-primary : Theme.text;
                    font-size: Theme.font-md;
                    font-weight: root.library-active ? 600 : 400;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-lib := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-library(); }
            }
        }

        Rectangle {
            height: 40px;
            background: touch-set.has-hover || root.settings-active ? (root.settings-active ? Theme.primary : Theme.surface) : transparent;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: Theme.pad-sm;
                padding-right: Theme.pad-sm;
                spacing: Theme.space-sm;

                Image {
                    source: @image-url("../icons/settings.svg");
                    width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    colorize: root.settings-active ? Theme.text-on-primary : Theme.text-muted;
                }

                Text {
                    text: "Settings";
                    color: root.settings-active ? Theme.text-on-primary : Theme.text;
                    font-size: Theme.font-md;
                    font-weight: root.settings-active ? 600 : 400;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-set := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-settings(); }
            }
        }

        Rectangle {
            height: 40px;
            background: touch-logs.has-hover || root.logs-active ? (root.logs-active ? Theme.primary : Theme.surface) : transparent;
            border-radius: Theme.radius-sm;

            HorizontalLayout {
                padding-left: Theme.pad-sm;
                padding-right: Theme.pad-sm;
                spacing: Theme.space-sm;

                Image {
                    source: @image-url("../icons/file-text.svg");
                    width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    colorize: root.logs-active ? Theme.text-on-primary : Theme.text-muted;
                }

                Text {
                    text: "Logs";
                    color: root.logs-active ? Theme.text-on-primary : Theme.text;
                    font-size: Theme.font-md;
                    font-weight: root.logs-active ? 600 : 400;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                }
            }

            touch-logs := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.nav-logs(); }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: "Poketto v0.1.0";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }
    }
}
