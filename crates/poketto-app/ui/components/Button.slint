import { Theme } from "../tokens.slint";

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> fill;
    in property <bool> disabled: false;
    in property <bool> show-icon: false;
    in property <image> icon;
    in property <length> btn-height: 36px;
    in property <int> font-weight: 400;
    callback clicked;

    background: root.primary
        ? (touch.pressed ? Theme.primary-pressed : touch.has-hover ? Theme.primary-hover : Theme.primary)
        : (touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-radius: Theme.radius-md;
    height: root.btn-height;
    min-width: layout.preferred-width;
    horizontal-stretch: root.fill ? 1 : 0;
    opacity: root.disabled ? 0.5 : 1;

    layout := HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;
        spacing: Theme.space-sm;
        alignment: center;

        if root.show-icon : Rectangle {
            width: 16px;
            vertical-stretch: 1;

            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
                colorize: root.primary ? Theme.text-on-primary : Theme.text;
            }
        }

        Text {
            text: root.text;
            color: root.primary ? Theme.text-on-primary : Theme.text;
            font-size: Theme.font-md;
            font-weight: root.font-weight;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
