import { Theme } from "../tokens.slint";
import { Button } from "../components/Button.slint";

export struct GameCardData {
    id: string,
    title: string,
    rating: float,
    show-cover: bool,
    hidden: bool,
    is-nsfw: bool,
    revealed: bool,
    playtime: string,
    playing: bool,
    cover: image,
}

export component GameCard inherits Rectangle {
    in property <GameCardData> game;
    in property <bool> blur-nsfw;
    callback clicked(string);
    callback play-game(string);
    callback edit-game(string);
    callback toggle-hide(string);
    callback remove-game(string);
    callback reveal-cover(string);

    property <bool> blocked: root.game.is-nsfw && root.blur-nsfw && !root.game.revealed;

    width: 195px;

    VerticalLayout {
        spacing: Theme.space-sm;

        Rectangle {
            width: 195px;
            height: 275px;
            background: Theme.surface;
            border-width: 1px;
            border-color: touch.has-hover ? Theme.accent : Theme.border;
            border-radius: Theme.radius-xl;
            clip: true;

            if !root.game.show-cover && !root.blocked : Text {
                text: "No cover";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            if root.game.show-cover && !root.blocked : Image {
                source: root.game.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }

            if root.blocked : Rectangle {
                background: Theme.surface;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.reveal-cover(root.game.id); }
                }

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: Theme.space-sm;

                    Text {
                        text: root.game.title;
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        overflow: elide;
                        height: 34px;
                        width: 100%;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "NSFW Content";
                        color: Theme.text;
                        font-size: Theme.font-md;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;

                        Button {
                            text: "Show Anyway";
                            primary: true;
                            clicked => { root.reveal-cover(root.game.id); }
                        }
                    }
                }
            }

            if root.game.rating > 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: badge-layout.preferred-width;
                height: badge-layout.preferred-height;
                background: Theme.primary;
                border-radius: Theme.radius-sm;

                badge-layout := HorizontalLayout {
                    padding-left: Theme.pad-sm;
                    padding-right: Theme.pad-sm;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 4px;

                    Rectangle {
                        width: 12px;
                        vertical-stretch: 1;
                        Image {
                            source: @image-url("../icons/star.svg");
                            width: 12px;
                            height: 12px;
                            y: (parent.height - 12px) / 2;
                            colorize: Theme.text-on-primary;
                        }
                    }

                    Text {
                        text: Math.round(root.game.rating * 10) / 10;
                        color: Theme.text-on-primary;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        vertical-stretch: 1;
                    }
                }
            }

            if root.game.playing : Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                width: play-layout.preferred-width;
                height: play-layout.preferred-height;
                background: Theme.royal-deep;
                border-radius: Theme.radius-pill;

                play-layout := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;

                    Text {
                        text: "Playing";
                        color: Theme.text-on-primary;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if !root.blocked : Rectangle {
                y: parent.height - self.height;
                width: 100%;
                height: 120px;
                background: @linear-gradient(180deg, #00000000 0%, #00000073 25%, #000000f2 100%);
                opacity: touch.has-hover ? 1.0 : 0.0;
                animate opacity { duration: 150ms; }

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 12px;
                    alignment: end;
                    spacing: 6px;

                    Text {
                        text: root.game.title;
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 34px;
                        horizontal-alignment: left;
                        width: 100%;
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: root.game.playtime != "" ? root.game.playtime : "0m";
                            color: Theme.surface-pressed;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: Theme.primary;
                            border-width: 1px;
                            border-color: #ffffff30;

                            Image {
                                source: @image-url("../icons/player-play.svg");
                                width: 14px;
                                height: 14px;
                                x: (parent.width - 14px) / 2 + 1px;
                                y: (parent.height - 14px) / 2;
                                colorize: #ffffff;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.play-game(root.game.id); }
                            }
                        }
                    }
                }
            }

            if touch.has-hover && !root.blocked : Rectangle {
                x: 10px;
                y: 10px;
                width: 28px;
                height: 28px;
                background: #00000099;
                border-radius: 14px;

                Text {
                    text: "...";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 700;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2 - 4px;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit-game(root.game.id); }
                }
            }

        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.game.id); }
    }

    menu := ContextMenuArea {
        width: 100%;
        height: 100%;

        Menu {
            MenuItem {
                title: "Play Game";
                activated => { root.play-game(root.game.id); }
            }

            MenuItem {
                title: "Edit Details";
                activated => { root.edit-game(root.game.id); }
            }

            MenuItem {
                title: root.game.hidden ? "Unhide Game" : "Hide Game";
                activated => { root.toggle-hide(root.game.id); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Remove from Library";
                activated => { root.remove-game(root.game.id); }
            }
        }
    }
}
