import { Theme } from "../tokens.slint";

export component TagBadge inherits Rectangle {
    in property <string> text;
    in property <bool> highlighted;
    in property <bool> spoiler: false;

    background: Theme.surface;
    border-width: 1px;
    border-color: root.spoiler ? #e06c75 : Theme.border;
    border-radius: Theme.radius-sm;
    width: layout.preferred-width;
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        padding-top: 4px;
        padding-bottom: 4px;

        Text {
            text: root.text;
            color: root.highlighted ? Theme.primary : Theme.text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}
