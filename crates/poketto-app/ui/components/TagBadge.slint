import { Theme } from "../tokens.slint";

export component TagBadge inherits Rectangle {
    in property <string> text;
    in property <bool> highlighted;
    in property <bool> spoiler: false;

    background: root.spoiler ? #381014 : #1c1e24;
    border-width: 1px;
    border-color: root.spoiler ? #7f1d1d : #2e323b;
    border-radius: Theme.radius-sm;
    width: layout.preferred-width;
    height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: Theme.pad-sm;
        padding-right: Theme.pad-sm;
        padding-top: 4px;
        padding-bottom: 4px;

        Text {
            text: root.text;
            color: root.highlighted ? Theme.primary : (root.spoiler ? #fca5a5 : #e2e8f0);
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}
