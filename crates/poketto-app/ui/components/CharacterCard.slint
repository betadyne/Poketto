import { Theme } from "../tokens.slint";
import { TagBadge } from "../components/TagBadge.slint";

export struct DetailCharacter {
    id: string,
    name: string,
    role: string,
    spoiler: int,
    description: string,
    avatar: image,
}

export component CharacterCard inherits Rectangle {
    in property <DetailCharacter> entry;
    in property <bool> show-spoilers;

    min-width: 280px;
    max-width: 320px;
    horizontal-stretch: 1;
    height: 110px;
    background: #1a1d24;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    clip: true;

    HorizontalLayout {
        padding: 8px;
        spacing: Theme.space-sm;

        Rectangle {
            width: 75px;
            height: 100px;
            background: Theme.surface;
            border-radius: 6px;
            clip: true;

            Image {
                source: root.entry.avatar;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Text {
                text: root.entry.name;
                color: Theme.text;
                font-size: Theme.font-md;
                font-weight: 700;
            }

            TagBadge {
                text: root.entry.role == "" ? "Character" : root.entry.role;
            }

            if root.entry.description != "" : Text {
                text: root.entry.description;
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                height: 45px;
            }

            if root.entry.description == "" && root.entry.spoiler > 0 && !root.show-spoilers : Text {
                text: "Description hidden — enable spoilers";
                color: Theme.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
