import { Theme } from "tokens.slint";
import { GameCardData } from "components/GameCard.slint";
import { GameEditOverlay, GameFormData, VndbHit } from "components/GameEditOverlay.slint";
import { LibraryView } from "views/LibraryView.slint";
import { DetailView, DetailTag, DetailCharacter } from "views/DetailView.slint";
import { SettingsView, WineRow } from "views/SettingsView.slint";
import { LogsView, LogLine } from "views/LogsView.slint";

export component AppWindow inherits Window {
    title: "Poketto";
    min-width: 800px;
    min-height: 600px;
    background: Theme.bg-dark;
    in-out property <string> detail-id;
    in-out property <string> detail-title;
    in-out property <int> screen;
    in-out property <[GameCardData]> games;
    in-out property <string> query;
    in-out property <int> active-filter;

    in-out property <image> detail-cover;
    in-out property <bool> detail-show-cover;
    in-out property <string> detail-meta;
    in-out property <string> detail-playtime;
    in-out property <string> detail-synopsis;
    in-out property <bool> detail-finished;
    in-out property <bool> detail-playing;
    in-out property <string> detail-error;
    in-out property <bool> detail-nsfw;
    in-out property <bool> detail-cover-revealed;
    in-out property <bool> detail-show-spoilers;
    in-out property <bool> detail-refreshing;
    in-out property <int> detail-collection-status;
    in-out property <int> detail-collection-vote;
    in-out property <string> detail-collection-msg;
    in-out property <bool> detail-collection-error;
    in-out property <[DetailTag]> detail-tags;
    in-out property <[DetailCharacter]> detail-characters;
    in-out property <[LogLine]> logs-lines;
    in-out property <string> logs-status;

    in-out property <string> set-wine-binary;
    in-out property <string> set-wine-prefix;
    in-out property <bool> set-steam-runtime;
    in-out property <bool> set-discord-enabled;
    in-out property <bool> set-btn-game;
    in-out property <bool> set-btn-profile;
    in-out property <bool> set-btn-github;
    in-out property <bool> set-blur;
    in-out property <string> set-vndb-token;
    in-out property <[WineRow]> wine-runners;
    in-out property <string> playing-id;
    in-out property <bool> show-hidden;
    in-out property <int> library-rev;

    in-out property <bool> edit-open;
    in-out property <string> edit-heading;
    in-out property <string> edit-id;
    in-out property <string> edit-title;
    in-out property <string> edit-vndb-id;
    in-out property <string> edit-exec-path;
    in-out property <string> edit-work-dir;
    in-out property <string> edit-cover-url;
    in-out property <int> edit-platform;
    in-out property <string> edit-wine-prefix;
    in-out property <string> edit-wine-binary;
    in-out property <string> edit-error;
    in-out property <string> edit-vndb-query;
    in-out property <[VndbHit]> edit-vndb-hits;
    in-out property <bool> edit-searching;
    in-out property <[string]> edit-available-runners;
    in-out property <[string]> edit-available-prefixes;
    in-out property <int> sort-index;

    callback game-clicked(string);
    callback search-accepted(string);
    callback search-query-changed(string);
    callback toggle-show-hidden(bool);
    callback filter-changed(int);
    callback sort-changed(string, bool);
    callback open-settings;
    callback open-logs;
    callback detail-back;
    callback launch-clicked(string);
    callback configure-clicked;
    callback edit-clicked;
    callback refresh-metadata;
    callback settings-back;
    callback settings-save;
    callback browse-default-prefix;
    callback logs-back;
    callback logs-copy;
    callback logs-clear;
    callback detect-wine;
    callback select-wine(string);
    callback add-clicked;
    callback play-game(string);
    callback edit-game(string);
    callback toggle-hide(string);
    callback remove-game(string);
    callback reveal-cover(string);
    callback spoilers-toggled(bool);
    callback collection-save(int, int);
    callback edit-browse;
    callback edit-browse-cover;
    callback edit-browse-prefix;
    callback edit-pick-runner(string);
    callback edit-pick-prefix(string);
    callback edit-search(string);
    callback edit-save(GameFormData);
    callback edit-cancel;

    if root.screen == 0 : LibraryView {
        width: 100%;
        height: 100%;
        games <=> root.games;
        query <=> root.query;
        active-filter <=> root.active-filter;
        blur-nsfw <=> root.set-blur;
        game-clicked(id) => { root.game-clicked(id); }
        search-accepted(query) => { root.search-accepted(query); }
        search-query-changed(query) => { root.search-query-changed(query); }
        toggle-show-hidden(value) => { root.toggle-show-hidden(value); }
        show-hidden <=> root.show-hidden;
        filter-changed(index) => { root.filter-changed(index); }
        sort-index <=> root.sort-index;
        sort-changed(field, asc) => { root.sort-changed(field, asc); }
        open-settings => { root.open-settings(); }
        add-clicked => { root.add-clicked(); }
        play-game(id) => { root.play-game(id); }
        edit-game(id) => { root.edit-game(id); }
        toggle-hide(id) => { root.toggle-hide(id); }
        remove-game(id) => { root.remove-game(id); }
        reveal-cover(id) => { root.reveal-cover(id); }
    }

    if root.screen == 1 : DetailView {
        width: 100%;
        height: 100%;
        title <=> root.detail-title;
        cover <=> root.detail-cover;
        show-cover <=> root.detail-show-cover;
        meta-line <=> root.detail-meta;
        playtime-line <=> root.detail-playtime;
        synopsis <=> root.detail-synopsis;
        finished <=> root.detail-finished;
        playing <=> root.detail-playing;
        launch-error <=> root.detail-error;
        cover-nsfw <=> root.detail-nsfw;
        blur-nsfw <=> root.set-blur;
        cover-revealed <=> root.detail-cover-revealed;
        show-spoilers <=> root.detail-show-spoilers;
        collection-status <=> root.detail-collection-status;
        collection-vote <=> root.detail-collection-vote;
        collection-msg <=> root.detail-collection-msg;
        collection-error <=> root.detail-collection-error;
        tags <=> root.detail-tags;
        characters <=> root.detail-characters;
        back => { root.detail-back(); }
        launch => { root.launch-clicked(root.detail-id); }
        configure => { root.configure-clicked(); }
        edit-clicked => { root.edit-clicked(); }
        refreshing <=> root.detail-refreshing;
        refresh-metadata => { root.refresh-metadata(); }
        spoilers-toggled(allowed) => { root.spoilers-toggled(allowed); }
        collection-save(status, vote) => { root.collection-save(status, vote); }
    }

    if root.screen == 2 : SettingsView {
        width: 100%;
        height: 100%;
        wine-binary <=> root.set-wine-binary;
        wine-prefix <=> root.set-wine-prefix;
        steam-runtime <=> root.set-steam-runtime;
        discord-enabled <=> root.set-discord-enabled;
        btn-game <=> root.set-btn-game;
        btn-profile <=> root.set-btn-profile;
        btn-github <=> root.set-btn-github;
        blur-nsfw <=> root.set-blur;
        vndb-token <=> root.set-vndb-token;
        runners <=> root.wine-runners;
        save => { root.settings-save(); }
        back => { root.settings-back(); }
        browse-default-prefix => { root.browse-default-prefix(); }
        detect-wine => { root.detect-wine(); }
        select-wine(binary) => { root.select-wine(binary); }
        open-logs => { root.open-logs(); }
    }

    if root.screen == 3 : LogsView {
        width: 100%;
        height: 100%;
        lines <=> root.logs-lines;
        status <=> root.logs-status;
        back => { root.logs-back(); }
        copy-logs => { root.logs-copy(); }
        clear-logs => { root.logs-clear(); }
    }
    if root.edit-open : GameEditOverlay {
        heading <=> root.edit-heading;
        game-id <=> root.edit-id;
        title <=> root.edit-title;
        vndb-id <=> root.edit-vndb-id;
        exec-path <=> root.edit-exec-path;
        work-dir <=> root.edit-work-dir;
        cover-url <=> root.edit-cover-url;
        platform <=> root.edit-platform;
        wine-prefix <=> root.edit-wine-prefix;
        wine-binary <=> root.edit-wine-binary;
        form-error <=> root.edit-error;
        vndb-query <=> root.edit-vndb-query;
        vndb-hits <=> root.edit-vndb-hits;
        searching <=> root.edit-searching;
        available-runners <=> root.edit-available-runners;
        available-prefixes <=> root.edit-available-prefixes;
        browse => { root.edit-browse(); }
        browse-cover => { root.edit-browse-cover(); }
        browse-prefix => { root.edit-browse-prefix(); }
        pick-runner(binary) => { root.edit-pick-runner(binary); }
        pick-prefix(prefix) => { root.edit-pick-prefix(prefix); }
        search-vndb(query) => { root.edit-search(query); }
        save-game(form) => { root.edit-save(form); }
        cancel => { root.edit-cancel(); }
        pick-hit(hit) => {
            root.edit-title = hit.title;
            root.edit-vndb-id = hit.id;
            root.edit-cover-url = hit.cover-url;
        }
    }
}
