import { Theme } from "tokens.slint";
import { Button } from "components/Button.slint";
import { TagBadge } from "components/TagBadge.slint";
import { SearchBar } from "components/SearchBar.slint";
import { GameCardData } from "components/GameCard.slint";
import { GameEditOverlay } from "components/GameEditOverlay.slint";
import { LibraryView } from "views/LibraryView.slint";
import { DetailView } from "views/DetailView.slint";
import { SettingsView } from "views/SettingsView.slint";
import { LogsView } from "views/LogsView.slint";

export component Preview inherits Window {
    title: "Poketto UI Preview";
    width: 560px;
    height: 440px;
    background: Theme.bg-dark;

    VerticalLayout {
        padding: Theme.pad-lg;
        spacing: Theme.space-md;

        Text {
            text: "Buttons";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            Button {
                text: "Default";
            }

            Button {
                text: "Primary";
                primary: true;
            }
        }

        Text {
            text: "Badges";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            TagBadge {
                text: "Drama";
            }

            TagBadge {
                text: "Finished";
                highlighted: true;
            }
        }

        Text {
            text: "Search";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
        }

        query := SearchBar {
        }

        Text {
            text: "Query: \{query.text}";
            color: Theme.text;
            font-size: Theme.font-md;
        }
    }
}

export component LibraryPreview inherits Window {
    title: "Poketto Library Preview";
    width: 900px;
    height: 640px;
    background: Theme.bg-dark;

    LibraryView {
        width: 100%;
        height: 100%;
        active-filter: 0;
        blur-nsfw: true;
        games: [
            { id: "g1", title: "Muv-Luv Alternative", rating: 8.55, show-cover: false },
            { id: "g2", title: "Steins;Gate", rating: 9.1, show-cover: false },
            { id: "g3", title: "A very long visual novel title that must elide gracefully", rating: 7.2, show-cover: false, is-nsfw: true },
            { id: "g4", title: "Unrated Game", rating: 0, show-cover: false },
            { id: "g5", title: "Fate/stay night", rating: 8.9, show-cover: false },
            { id: "g6", title: "Clannad", rating: 8.7, show-cover: false },
        ];
    }
}

export component DetailPreview inherits Window {
    title: "Poketto Detail Preview";
    width: 900px;
    height: 700px;
    background: Theme.bg-dark;

    DetailView {
        width: 100%;
        height: 100%;
        title: "Muv-Luv Alternative";
        show-cover: false;
        meta-line: "2006 · 8.55 · 3000 min";
        playtime-line: "Played 2h 5m · Finished";
        synopsis: "A story of humanity fighting against the alien BETA invaders.";
        finished: true;
        playing: true;
        tags: [
            { name: "Drama", spoiler: 0 },
            { name: "Sci-Fi", spoiler: 0 },
            { name: "Secret Ending", spoiler: 2 },
        ];
        characters: [
            { name: "Takeru Shirogane", role: "main", spoiler: 0 },
            { name: "Meiya Mitsurugi", role: "main", spoiler: 0 },
            { name: "Mystery Pilot", role: "supporting", spoiler: 1 },
        ];
        show-spoilers: false;
    }
}

export component SettingsPreview inherits Window {
    title: "Poketto Settings Preview";
    width: 700px;
    height: 720px;
    background: Theme.bg-dark;

    SettingsView {
        width: 100%;
        height: 100%;
        wine-binary: "/usr/bin/wine";
        wine-prefix: "/home/user/Games/Poketto/GlobalPrefix";
        steam-runtime: true;
        discord-enabled: true;
        btn-game: true;
        btn-profile: false;
        btn-github: true;
        blur-nsfw: true;
        runners: [
            { name: "Wine 9.0 (64-bit)", binary: "/usr/bin/wine64" },
            { name: "GE-Proton9-7", binary: "/home/user/.steam/root/compatibilitytools.d/GE-Proton9-7/proton" },
        ];
    }
}

export component EditorPreview inherits Window {
    title: "Poketto Editor Preview";
    width: 640px;
    height: 720px;
    background: Theme.bg-dark;

    GameEditOverlay {
        heading: "Add game";
        title: "Muv-Luv Alternative";
        vndb-id: "v17";
        exec-path: "/games/muvluv/game.exe";
        platform: 2;
        wine-prefix: "/home/user/Games/Poketto/Prefixes/demo";
        vndb-query: "muv-luv";
        vndb-hits: [
            { id: "v17", title: "Muv-Luv Alternative", cover-url: "https://img.jpg" },
            { id: "v18", title: "Muv-Luv Unlimited", cover-url: "" },
        ];
    }
}

export component LogsPreview inherits Window {
    title: "Poketto Logs Preview";
    width: 700px;
    height: 600px;
    background: Theme.bg-dark;

    LogsView {
        width: 100%;
        height: 100%;
        status: "";
        lines: [
            { text: "12:01:01 [INFO] poketto_app: settings saved", level: 0 },
            { text: "12:01:33 [WARN] poketto_core::vndb: slow response", level: 1 },
            { text: "12:02:07 [ERROR] poketto_core::discord: connect failed", level: 2 },
        ];
    }
}
