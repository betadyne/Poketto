import { ListView } from "std-widgets.slint";
import { Theme } from "../tokens.slint";
import { Button } from "../components/Button.slint";
import { GameCard, GameCardData } from "../components/GameCard.slint";

import { SearchBar } from "../components/SearchBar.slint";
export component LibraryView inherits Rectangle {
    in-out property <[GameCardData]> games;
    in-out property <string> query;
    in-out property <int> sort-index: 0;
    in-out property <int> active-filter;
    in property <bool> blur-nsfw;
    in property <bool> show-hidden: false;
    in property <int> columns: Math.max(1, Math.floor((root.width / 1px - 80) / 215));
    property <bool> list-mode: false;

    callback game-clicked(string);
    callback search-accepted(string);
    callback search-query-changed(string);
    callback toggle-show-hidden(bool);
    callback filter-changed(int);
    callback sort-changed(string, bool);
    callback add-clicked;
    callback play-game(string);
    callback edit-game(string);
    callback toggle-hide(string);
    callback remove-game(string);
    callback reveal-cover(string);
    changed query => { root.search-query-changed(root.query); }
    property <int> row-count: Math.ceil(games.length / root.columns);

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 24px;
            padding-bottom: 16px;
            spacing: 0;

            Text {
                text: "Overview";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 12px;

                SearchBar {
                    width: 360px;
                    text <=> root.query;
                    placeholder: "Search game titles...";
                    accepted(query) => { root.search-accepted(query); }
                }

                Button {
                    text: "+ Add Game";
                    width: 110px;
                    primary: true;
                    btn-height: 38px;
                    font-weight: 600;
                    clicked => { root.add-clicked(); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.surface;
        }

        VerticalLayout {
            padding-left: 32px;
            padding-right: 32px + 16px;
            padding-top: 14px;
            padding-bottom: 32px;
            spacing: 0;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: "All Games";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: "(" + root.games.length + ")";
                color: Theme.text-muted;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                height: 32px;
                width: sort-pill.preferred-width;
                background: touch-sort.has-hover ? Theme.surface-hover : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                sort-pill := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: ["Sort by Name", "Title Z-A", "Most Played", "Recently Played"][root.sort-index];
                        color: Theme.text-soft;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "∨";
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                sort-popup := PopupWindow {
                    x: 0;
                    y: parent.height + 4px;
                    width: 160px;
                    height: sort-options.preferred-height;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: Theme.sidebar;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000015;

                        sort-options := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;

                            for label[i] in ["Sort by Name", "Title Z-A", "Most Played", "Recently Played"] : Rectangle {
                                height: 32px;
                                background: touch-opt.has-hover ? Theme.surface : transparent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: label;
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "✓";
                                        color: #10b981;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        visible: i == root.sort-index;
                                    }
                                }

                                touch-opt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (label == "Sort by Name") { root.sort-changed("title", true); }
                                        else if (label == "Title Z-A") { root.sort-changed("title", false); }
                                        else if (label == "Most Played") { root.sort-changed("play_time", false); }
                                        else { root.sort-changed("last_played", false); }
                                        sort-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }

                touch-sort := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { sort-popup.show(); }
                }
            }

            Rectangle {
                height: 32px;
                width: filter-pill.preferred-width;
                background: touch-filter.has-hover ? Theme.surface-hover : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                filter-pill := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 6px;
                    alignment: center;

                    Image {
                        source: @image-url("../icons/filter.svg");
                        width: 14px;
                        height: 14px;
                        y: (parent.height - 14px) / 2;
                        colorize: Theme.text-soft;
                    }

                    Text {
                        text: "Filters ∨";
                        color: Theme.text-soft;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                filter-popup := PopupWindow {
                    x: parent.width - self.width;
                    y: parent.height + 4px;
                    width: 170px;
                    height: filter-options.preferred-height;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        background: Theme.sidebar;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 12px;
                        drop-shadow-blur: 16px;
                        drop-shadow-color: #00000015;

                        filter-options := VerticalLayout {
                            padding: 6px;
                            spacing: 2px;

                            for label[i] in ["All", "Unfinished", "Finished", "Hidden"] : Rectangle {
                                height: 32px;
                                background: touch-fopt.has-hover ? Theme.surface : transparent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: label;
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "✓";
                                        color: #10b981;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        visible: i == root.active-filter;
                                    }
                                }

                                touch-fopt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.filter-changed(i);
                                        filter-popup.close();
                                    }
                                }
                            }

                            Rectangle {
                                height: 32px;
                                background: touch-hidden.has-hover ? Theme.surface : transparent;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: root.show-hidden ? "Hide Hidden" : "Show Hidden";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: "✓";
                                        color: #10b981;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        visible: root.show-hidden;
                                    }
                                }

                                touch-hidden := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.toggle-show-hidden(!root.show-hidden);
                                        filter-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }

                touch-filter := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { filter-popup.show(); }
                }
            }

            Rectangle {
                width: 1px;
                height: 20px;
                y: (parent.height - 20px) / 2;
                background: Theme.border;
            }

            Rectangle {
                height: 32px;
                width: mode-toggle.preferred-width;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 8px;

                mode-toggle := HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    Rectangle {
                        width: 32px;
                        height: 24px;
                        background: !root.list-mode ? Theme.sidebar : transparent;
                        border-radius: Theme.radius-pill;

                        Image {
                            source: @image-url("../icons/layout-grid.svg");
                            width: 16px;
                            height: 16px;
                            x: (parent.width - 16px) / 2;
                            y: (parent.height - 16px) / 2;
                            colorize: !root.list-mode ? Theme.text : Theme.text-faint;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.list-mode = false; }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 24px;
                        background: root.list-mode ? Theme.sidebar : transparent;
                        border-radius: Theme.radius-pill;

                        Image {
                            source: @image-url("../icons/list.svg");
                            width: 16px;
                            height: 16px;
                            x: (parent.width - 16px) / 2;
                            y: (parent.height - 16px) / 2;
                            colorize: root.list-mode ? Theme.text : Theme.text-faint;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.list-mode = true; }
                        }
                    }
                }
            }
        }

        Rectangle { height: 24px; }

        if root.games.length == 0 : Text {
            text: "No games in the library yet.";
            color: Theme.text-muted;
            font-size: Theme.font-md;
        }

        if !root.list-mode : list := ListView {
            vertical-stretch: 1;

            for r in root.row-count : Rectangle {
                height: 284px;

                HorizontalLayout {
                    height: 276px;
                    spacing: 20px;
                    alignment: start;

                    for c in root.columns : Rectangle {
                        width: 195px;

                        property <int> index: r * root.columns + c;

                        if index < root.games.length : GameCard {
                            game: root.games[index];
                            blur-nsfw: root.blur-nsfw;
                            clicked(id) => { root.game-clicked(id); }
                            play-game(id) => { root.play-game(id); }
                            edit-game(id) => { root.edit-game(id); }
                            toggle-hide(id) => { root.toggle-hide(id); }
                            remove-game(id) => { root.remove-game(id); }
                            reveal-cover(id) => { root.reveal-cover(id); }
                        }
                    }
                }
            }
        }

        if root.list-mode : ListView {
            vertical-stretch: 1;

            for game in root.games : Rectangle {
                height: 72px;

                Rectangle {
                    y: 4px;
                    width: 100%;
                    height: 64px;
                    background: Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;

                HorizontalLayout {
                    padding-left: Theme.pad-sm;
                    padding-right: Theme.pad-sm;
                    spacing: Theme.space-sm;

                    Rectangle {
                        width: 36px;
                        height: 48px;
                        y: (parent.height - 48px) / 2;
                        background: Theme.surface;
                        border-radius: 6px;
                        clip: true;

                        if game.show-cover : Image {
                            source: game.cover;
                            width: 100%;
                            height: 100%;
                            image-fit: ImageFit.cover;
                        }
                    }

                    Text {
                        text: game.title;
                        color: Theme.text;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if game.rating > 0 : Text {
                        text: Math.round(game.rating * 10) / 10;
                        color: Theme.text-muted;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "Play";
                        primary: true;
                        clicked => { root.play-game(game.id); }
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.game-clicked(game.id); }
                }
                }
            }
        }
    }

}
}
