import { Theme } from "../tokens.slint";
import { Switch } from "std-widgets.slint";
import { Button } from "../components/Button.slint";
import { TagBadge } from "../components/TagBadge.slint";

export struct DetailTag {
    name: string,
    spoiler: int,
}

export struct DetailCharacter {
    name: string,
    role: string,
    spoiler: int,
}

export component DetailView inherits Rectangle {
    in property <string> title;
    in property <image> cover;
    in property <bool> show-cover;
    in property <string> meta-line;
    in property <string> playtime-line;
    in property <string> synopsis;
    in property <bool> finished;
    in property <bool> playing;
    in property <string> launch-error;
    in property <bool> cover-nsfw;
    in property <bool> blur-nsfw;
    in-out property <bool> cover-revealed;
    in-out property <bool> show-spoilers;
    in property <[DetailTag]> tags;
    in property <[DetailCharacter]> characters;

    callback back;
    callback launch;
    callback configure;
    callback edit-clicked;
    callback spoilers-toggled(bool);

    property <bool> cover-blocked: root.cover-nsfw && root.blur-nsfw && !root.cover-revealed;

    Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            padding: Theme.pad-lg;
            spacing: Theme.space-md;

            HorizontalLayout {
                spacing: Theme.space-sm;

                Button {
                    text: "Back";
                    clicked => { root.back(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-md;

                Rectangle {
                    width: 120px;
                    height: 160px;
                    background: Theme.surface;
                    border-radius: Theme.radius-md;
                    clip: true;

                    if !root.show-cover : Text {
                        text: "No cover";
                        color: Theme.text-muted;
                        font-size: Theme.font-sm;
                    }

                    if root.show-cover && !root.cover-blocked : Image {
                        source: root.cover;
                        width: 100%;
                        height: 100%;
                        image-fit: ImageFit.cover;
                    }

                    if root.cover-blocked : Rectangle {
                        background: Theme.surface;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: "NSFW Content";
                                color: Theme.text;
                                font-size: Theme.font-md;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Tap to reveal";
                                color: Theme.text-muted;
                                font-size: Theme.font-sm;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => { root.cover-revealed = true; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-sm;
                    vertical-stretch: 1;

                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Theme.font-lg;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.meta-line;
                        color: Theme.text-muted;
                        font-size: Theme.font-md;
                    }

                    Text {
                        text: root.playtime-line;
                        color: Theme.text-muted;
                        font-size: Theme.font-md;
                    }

                    if root.finished : HorizontalLayout {
                        TagBadge {
                            text: "Finished";
                            highlighted: true;
                        }
                    }

                    if root.playing : Text {
                        text: "Now Playing";
                        color: Theme.primary;
                        font-size: Theme.font-md;
                    }

                    if root.launch-error != "" : Text {
                        text: root.launch-error;
                        color: Theme.danger;
                        font-size: Theme.font-md;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        Button {
                            text: root.playing ? "Playing..." : "Launch";
                            primary: true;
                            clicked => { root.launch(); }
                        }

                        Button {
                            text: "Config";
                            clicked => { root.configure(); }
                        }

                        Button {
                            text: "Edit";
                            clicked => { root.edit-clicked(); }
                        }
                    }
                }
            }

            Text {
                text: "Synopsis";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            Text {
                text: root.synopsis;
                color: Theme.text;
                font-size: Theme.font-md;
                wrap: word-wrap;
            }

            HorizontalLayout {
                Text {
                    text: "Show Spoilers";
                    color: Theme.text;
                    font-size: Theme.font-md;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Switch {
                    checked <=> root.show-spoilers;
                    toggled => { root.spoilers-toggled(root.show-spoilers); }
                }
            }

            if root.tags.length > 0 : Text {
                text: "Tags";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            if root.tags.length > 0 : HorizontalLayout {
                spacing: Theme.space-sm;

                for tag in root.tags : TagBadge {
                    text: tag.name;
                    visible: root.show-spoilers || tag.spoiler == 0;
                }
            }

            if root.characters.length > 0 : Text {
                text: "Characters";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            if root.characters.length > 0 : VerticalLayout {
                spacing: Theme.space-sm;

                for ch in root.characters : Text {
                    text: ch.role == "" ? ch.name : ch.name + " · " + ch.role;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    visible: root.show-spoilers || ch.spoiler == 0;
                }
            }
        }
    }
}
