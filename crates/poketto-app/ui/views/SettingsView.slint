import { Switch } from "std-widgets.slint";
import { Theme } from "../tokens.slint";
import { Button } from "../components/Button.slint";

export struct WineRow {
    name: string,
    binary: string,
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> label;

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    height: 40px;

    HorizontalLayout {
        padding-left: Theme.pad-md;
        padding-right: Theme.pad-md;

        input := TextInput {
            text <=> root.text;
            color: Theme.text;
            font-size: Theme.font-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component SwitchRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-md;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    Switch {
        checked <=> root.checked;
    }
}

export component SettingsView inherits Rectangle {
    in-out property <string> wine-binary;
    in-out property <string> wine-prefix;
    in-out property <bool> steam-runtime;
    in-out property <bool> discord-enabled;
    in-out property <bool> btn-game;
    in-out property <bool> btn-profile;
    in-out property <bool> btn-github;
    in-out property <bool> blur-nsfw;
    in-out property <[WineRow]> runners;

    callback back;
    callback save;
    callback detect-wine;
    callback select-wine(string);
    callback open-logs;

    Flickable {
        width: 100%;
        height: 100%;
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            padding: Theme.pad-lg;
            spacing: Theme.space-md;

            HorizontalLayout {
                spacing: Theme.space-sm;

                Button {
                    text: "Back";
                    clicked => { root.back(); }
                }

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: Theme.font-lg;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Wine / Proton";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            Text {
                text: "Detected runners (tap to select)";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            VerticalLayout {
                spacing: Theme.space-sm;

                for runner in root.runners : TouchArea {
                    clicked => { root.select-wine(runner.binary); }

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        Text {
                            text: runner.name;
                            color: Theme.text;
                            font-size: Theme.font-md;
                            vertical-alignment: center;
                        }

                        Text {
                            text: runner.binary;
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Button {
                text: "Detect runners";
                clicked => { root.detect-wine(); }
            }

            Text {
                text: "Default binary";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            Field {
                text <=> root.wine-binary;
            }

            Text {
                text: "Default prefix";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            Field {
                text <=> root.wine-prefix;
            }

            SwitchRow {
                label: "Use Steam runtime";
                checked <=> root.steam-runtime;
            }

            Text {
                text: "Discord";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            SwitchRow {
                label: "Rich Presence";
                checked <=> root.discord-enabled;
            }

            SwitchRow {
                label: "VNDB game button";
                checked <=> root.btn-game;
            }

            SwitchRow {
                label: "VNDB profile button";
                checked <=> root.btn-profile;
            }

            SwitchRow {
                label: "GitHub button";
                checked <=> root.btn-github;
            }

            Text {
                text: "Library";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
            }

            SwitchRow {
                label: "Blur NSFW covers";
                checked <=> root.blur-nsfw;
            }

            HorizontalLayout {
                Button {
                    text: "Save";
                    primary: true;
                    clicked => { root.save(); }
                }
            }

            HorizontalLayout {
                Button {
                    text: "View Logs";
                    clicked => { root.open-logs(); }
                }
            }
        }
    }
}
