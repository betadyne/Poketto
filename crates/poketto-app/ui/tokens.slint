export global Theme {
    out property <color> canvas: #f8fafc;
    out property <color> sidebar: #ffffff;
    out property <color> surface: #f1f5f9;
    out property <color> surface-hover: #e2e8f0;
    out property <color> surface-pressed: #cbd5e1;
    out property <color> primary: #0a1045;
    out property <color> primary-hover: #1e293b;
    out property <color> primary-pressed: #020617;
    out property <color> accent: #1d4ed8;
    out property <color> text: #0f172a;
    out property <color> text-on-primary: #ffffff;
    out property <color> text-muted: #64748b;
    out property <color> border: #e2e8f0;
    out property <color> danger: #dc2626;
    out property <color> warning: #d97706;

    out property <length> radius-sm: 8px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 12px;
    out property <length> radius-pill: 9999px;
    out property <length> pad-sm: 8px;
    out property <length> pad-md: 14px;
    out property <length> pad-lg: 20px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 14px;
    out property <length> space-lg: 20px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 20px;
    out property <length> font-xl: 24px;
}
